{{- $posts := slice -}}
{{- $available := where (where site.RegularPages "Section" "posts") "PublishDate" "le" now -}}
{{- if not hugo.IsServer -}}{{- $available = where $available "Draft" false -}}{{- end -}}
{{- range first 5 $available -}}
{{- $posts = $posts | append (dict "title" .Title "url" .RelPermalink "date" (.Date.Format "2006-01-02T15:04:05Z07:00") "description" (.Description | default (.Summary | plainify) | truncate 220 | htmlUnescape) "opinion" (partial "is-opinion.html" .) "draft" .Draft) -}}
{{- end -}}
{{- $posts | jsonify -}}
