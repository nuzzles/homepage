{
    "name": "homepage",
    "description": "Joint homepage of Spencer and Sara Imbleau",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0 <25",
        "pnpm": ">=11.25.0"
    },
    "author": "Spencer Imbleau",
    "scripts": {
        "dev": "node scripts/blog.mjs dev",
        "build": "tsc -b && vite build && node scripts/blog.mjs build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -b",
        "test": "vitest run --environment jsdom",
        "test:watch": "vitest --environment jsdom",
        "check": "prettier --check . && eslint . && tsc -b && vitest run --environment jsdom && vite build",
        "preview": "vite preview",
        "setup:hugo": "node scripts/setup-hugo.mjs"
    },
    "dependencies": {
        "@fontsource-variable/dm-sans": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.1",
        "@fontsource-variable/vazirmatn": "^5.3.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tooltip": "^1.4.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "i18next": "^26.4.2",
        "lucide-react": "^1.41.0",
        "mermaid": "12.0.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-helmet-async": "^3.0.0",
        "react-i18next": "^17.0.13",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.3",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.7.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    },
    "prettier": {
        "tabWidth": 4,
        "semi": false,
        "printWidth": 120,
        "trailingComma": "es5",
        "overrides": [
            {
                "files": [
                    "*.yml",
                    "*.yaml",
                    "tsconfig*.json"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    }
}
